<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- dotnet test -p:TestNetStandard=true runs the tests against the netstandard2.0 build of the library -->
  <ItemGroup Condition="'$(TestNetStandard)' != 'true'">
    <ProjectReference Include="../../src/TestingBot.Tunnel/TestingBot.Tunnel.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TestNetStandard)' == 'true'">
    <ProjectReference Include="../../src/TestingBot.Tunnel/TestingBot.Tunnel.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <!-- The dependencies of the netstandard2.0 build do not flow through SetTargetFramework -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
